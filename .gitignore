# ─────────── secrets & local config ───────────
.bart_config.json
# outreach pipeline: holds an Instagram Graph API token + optional TTS key
.outreach_config.json
# generated Reels awaiting review/publish — user content, never push
outreach/queue/
# user-supplied royalty-free music beds (the dir is kept via its .gitignore)
outreach/music/*
!outreach/music/.gitignore
.env
.env.*
!.env.example
# user-auth DB (emails, bcrypt hashes, session tokens) — never push
website/bart.db
website/bart.db-journal
website/bart.db-wal
website/bart.db-shm
# per-user workspace configs (each has a .bart_config.json with auth_mode)
.workspaces/
# npm artifacts — we don't actually use them, the website is React-via-Babel-Standalone
package-lock.json
node_modules/

# ─────────── python build / venv ───────────
.venv/
venv/
env/
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
build/
dist/
.eggs/

# ─────────── user-generated content ───────────
output/
materials/
logs/
*.log

# ─────────── caches ───────────
.cache/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# ─────────── internal / dev only (do not ship) ───────────
tests/
benchmarks/
.design_pkg/
.scratch/
TODO.md
NOTES.md
future.md
# pytest discovery & coverage artifacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/
conftest.py
pytest.ini
pyproject.toml.test
# nothing under tests should ever be packaged
**/test_*.py
**/*_test.py

# ─────────── editor / OS ───────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
